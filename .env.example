# Optional: point app + API routes to your own unified gateway (e.g. Vercel API gateway).
# If not set, the app defaults to https://api.muapi.ai.
NEXT_PUBLIC_MUAPI_BASE_URL=
# Example: https://your-gateway.example.com

# Optional server-only override for Next.js API routes/middleware.
# If unset, server routes also fall back to NEXT_PUBLIC_MUAPI_BASE_URL.
# Set this only when server-side traffic should use a different/internal gateway URL.
MUAPI_BASE_URL=
# Example: https://your-internal-gateway.example.com

# ─── Vercel AI Gateway ────────────────────────────────────────────────────────
#
# Set AI_GATEWAY_ENABLED=true and provide an AI_GATEWAY_API_KEY to route image
# and video generation through the Vercel AI Gateway instead of muapi.ai.
#
# Get your key at: https://vercel.com/dashboard → AI Gateway → API Keys
#
# When enabled, the following apply:
#   • /api/generate/image routes image-only models (Flux, Imagen, GPT Image,
#     Seedream, Recraft, Grok Imagine) via the Vercel AI Gateway.
#   • /api/generate/video routes video models (Kling, Veo, Wan, Seedance, Grok
#     Imagine Video) via the Vercel AI Gateway.
#   • Models without a gateway mapping automatically fall back to muapi.ai.
#   • Set NEXT_PUBLIC_AI_GATEWAY_ENABLED=true to make the browser client route
#     through these Next.js API routes (required for gateway to be used).
#
# No-markup pricing: tokens/images cost the same as going to the provider
# directly. See https://vercel.com/docs/ai-gateway for full documentation.
#
AI_GATEWAY_ENABLED=
# Example: true

AI_GATEWAY_API_KEY=
# Example: agk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Client-side flag — must be set to 'true' for the studio UI to use the
# /api/generate/* routes instead of calling muapi.ai directly.
NEXT_PUBLIC_AI_GATEWAY_ENABLED=
# Example: true

